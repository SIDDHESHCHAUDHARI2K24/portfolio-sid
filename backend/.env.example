# portfolio-backend local dev settings.
# Safe placeholders only — real secrets live in Railway env vars, never here.
# Field names map to app/core/config.py Settings (case-insensitive).

ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio

# Storage backend: "s3" (R2/MinIO, default) or "local" (disk fallback for dev/CI)
STORAGE_KIND=s3
LOCAL_STORAGE_DIR=.storage

# S3-compatible storage (local MinIO via docker-compose; Cloudflare R2 in prod)
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=portfolio-media
R2_PUBLIC_BASE_URL=

RESEND_API_KEY=
ADMIN_EMAIL=

TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

SESSION_SECRET=dev-only-secret
ADMIN_PASSWORD_HASH=

# JSON list. Empty = same-origin only; MUST stay empty in production.
# Example with origins: ["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_ORIGINS=[]

CF_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

REVALIDATION_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
